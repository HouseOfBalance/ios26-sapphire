+/*
+ * hakios/HAS_STD_PAC: mirror libkern/os/base.h's XNU_PTRAUTH_DATA_PTRS_PLAIN here so the
+ * assembler sees it too.  machine_routines_asm.h includes this header but NOT base.h, and the
+ * data-pointer auth macros (AUTDA_DIVERSIFIED etc.) must be gated on the exact same condition
+ * the C field qualifiers (XNU_PTRAUTH_SIGNED_PTR) are, or asm will autda a field the C side
+ * stored plain -> FPAC.  On this arm64e tree data pointers are left unsigned (the plain Mach-O
+ * loader has no keys to sign chained data fixups with); only code pointers / return addresses
+ * and the pacga state hash are authenticated.
+ */
+#if defined(__arm64e__) && !defined(XNU_PTRAUTH_SIGNED_DATA_PTRS) && !defined(XNU_PTRAUTH_DATA_PTRS_PLAIN)
