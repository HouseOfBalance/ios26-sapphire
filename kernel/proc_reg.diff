 #define SCTLR_PACDB_ENABLED       (1ULL << 13)
+#endif /* HAS_STD_PAC */
 
 #define SCTLR_PAC_KEYS_ENABLED    (SCTLR_PACIA_ENABLED | SCTLR_PACIB_ENABLED | SCTLR_PACDA_ENABLED | SCTLR_PACDB_ENABLED)
 #endif /* defined(HAS_APPLE_PAC) */
