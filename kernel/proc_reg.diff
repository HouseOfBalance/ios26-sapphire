+#if HAS_STD_PAC
+/*
+ * Standard ARMv8.3 SCTLR_EL1.  EnIA, EnIB, EnDA and EnDB enable the signing instructions that use
+ * the A and B keys for EL0 and EL1 alike (with a bit clear, the instruction executes as a NOP and
+ * authentication always passes, which is how the kernel boots before it has keys).  The positions
+ * are architectural (ARM DDI 0487): EnIA 31, EnIB 30, EnDA 27, EnDB 13.  Bits 29:28 are LSMAOE and
+ * nTLSMD (RES1, set by SCTLR_RESERVED) -- not PAC enables; the loader's pac_enable() must set the
+ * same four bits, or it signs with a data key the kernel never actually enabled.
+ */
+#define SCTLR_PACIA_ENABLED_SHIFT 31
+#define SCTLR_PACIA_ENABLED       (1ULL << SCTLR_PACIA_ENABLED_SHIFT)
+#define SCTLR_PACIB_ENABLED       (1ULL << 30)
+#define SCTLR_PACDA_ENABLED       (1ULL << 27)
+#define SCTLR_PACDB_ENABLED       (1ULL << 13)
+#else /* HAS_STD_PAC */
 // 31    PACIA_ENABLED AddPACIA and AuthIA functions enabled
 #define SCTLR_PACIA_ENABLED_SHIFT 31
 #define SCTLR_PACIA_ENABLED       (1ULL << SCTLR_PACIA_ENABLED_SHIFT)
